<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Blood_Donation"
        android:usesCleartextTraffic="true">

        <!-- Splash Launcher Screen -->
        <activity
            android:name=".ui.auth.SplashActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Auth Activities -->
        <activity android:name=".ui.auth.WelcomeActivity" />
        <activity android:name=".ui.auth.AccountTypeSelectionActivity" />
        <activity android:name=".ui.auth.LoginActivity" />
        <activity android:name=".ui.auth.RegisterActivity" />
        <activity android:name=".ui.auth.OrganizationRegisterActivity" />
        <activity android:name=".ui.auth.EmailVerificationActivity" />
        <activity android:name=".ui.auth.PendingApprovalActivity" />
        <activity android:name=".ui.auth.ForgotPasswordActivity" />

        <!-- Role Dashboards -->
        <activity android:name=".ui.dashboard.DonorDashboardActivity" />
        <activity android:name=".ui.dashboard.RequesterDashboardActivity" />
        <activity android:name=".ui.dashboard.HospitalDashboardActivity" />
        <activity android:name=".ui.dashboard.BloodBankDashboardActivity" />
        <activity android:name=".ui.dashboard.AdminDashboardActivity" />

    </application>

</manifest>
